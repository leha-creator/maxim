# Переменные окружения бэкенда (07 §8). Значения ниже — для локального запуска
# вне Docker против сервисов из compose.dev.yml. Секреты продакшена — только из
# хранилища секретов, не из файлов в репозитории.

# Окружение: development | test | production. В test внешние системы поддельные.
APP_ENV=development
# debug | info | warn | error. По умолчанию debug в разработке, info в остальных.
LOG_LEVEL=debug

HTTP_ADDR=:8080
METRICS_ADDR=:9090
PUBLIC_BASE_URL=http://localhost:8080
# Сети прокси, чьему X-Forwarded-For можно верить (через запятую).
TRUSTED_PROXY_CIDRS=
# В production обязательно true.
COOKIE_SECURE=false

# api и worker — роль приложения; migrate — владелец схемы.
DATABASE_URL=postgres://maxim_app:maxim_app@localhost:5432/maxim?sslmode=disable
# Роль, которой миграции выдают права (для maxim migrate).
DB_APP_ROLE=maxim_app
DB_MAX_CONNS=10

S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=maxim-private
# Публичная корзина (R-7): анонимное чтение без перечисления, только производные из версий поста.
# Адрес чтения — ключ объекта дописывается в конец; в production только https.
S3_BUCKET_PUBLIC=maxim-public
S3_PUBLIC_BASE_URL=http://localhost:9000/maxim-public
# Адрес хранилища в подписанных ссылках, если браузер видит его иначе, чем сервер; пусто — S3_ENDPOINT.
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_USE_SSL=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# starttls | tls | none (none — только разработка).
SMTP_TLS=none
MAIL_FROM=noreply@maxim.local

# 32 байта в base64: шифрование секретов в полезной нагрузке заданий (R-1).
# Сгенерировать: openssl rand -base64 32
APP_SECRETS_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE=
# Не короче 32 символов: секрет HMAC кода входа (R-3).
AUTH_CODE_PEPPER=dev-only-pepper-at-least-32-characters

# Вход и сессии (07 §4); длительности — в формате Go (600s, 720h).
AUTH_LOGIN_CODE_TTL=600s
AUTH_LOGIN_CODE_ATTEMPTS=5
AUTH_CODES_PER_EMAIL_HOUR=5
AUTH_CODES_PER_IP_HOUR=20
AUTH_SESSION_TTL=720h
AUTH_ADMIN_SESSION_TTL=12h

# MAX Bot API (05 §2.1). Без токена в разработке работает поддельный адаптер;
# в production токен обязателен, worker проверяет его при запуске.
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
# Корневой сертификат Минцифры (PEM); в образе — /etc/maxim/certs/ (deploy/certs/README.md).
MAX_CA_CERT_FILE=
# Общий ограничитель (05 §2.8): запросов в секунду на все экземпляры и сообщений в секунду в чат.
MAX_RATE_GLOBAL=25
MAX_RATE_PER_CHAT=1
# Пользователь MAX бота платформы (R-8): по нему отличаются свои сообщения в канале.
# Пусто — worker узнаёт его через GET /me.
MAX_BOT_USER_ID=
# Имя бота в инструкции подключения канала (S-12).
MAX_BOT_NAME=@maxim_dev_bot
# Приём Webhook MAX (R-3, Q-35): секретная часть адреса /api/v1/webhooks/max/{secret}
# и секрет подписки в заголовке X-Max-Bot-Api-Secret. Не короче 32 символов; в production обязательны.
MAX_WEBHOOK_PATH_SECRET=dev-only-webhook-path-secret-0123456789
MAX_WEBHOOK_SECRET=dev-only-webhook-header-secret-012345678
# Публичный адрес приёма без секретной части; worker в production подписывает на него бота (R-5).
MAX_WEBHOOK_URL=

# Подключение каналов (S-12, A-41, D-11): срок кода, предел кодов в час на организацию,
# сколько бот ждёт кода в канале, порог подписчиков для номера РКН.
CHANNEL_LINK_CODE_TTL=60m
CHANNEL_LINK_CODES_PER_HOUR=10
CHANNEL_UNCLAIMED_TTL=168h
RKN_SUBSCRIBERS_THRESHOLD=10000

# Каталог (S-02, S-13, S-16, S-32): комиссия платформы сверху цены блогера (базисные пункты,
# 1500 = 15 %), повторная проверка номера РКН, пороги флагов аномалий метрик (рост подписчиков
# за сутки, просмотры меньше доли подписчиков), пределы интервалов недоступности.
PLATFORM_FEE_RATE_BP=1500
RKN_RECHECK_INTERVAL=2160h
METRICS_SUBSCRIBERS_SPIKE_BP=2000
METRICS_VIEWS_MIN_BP=100
CHANNEL_UNAVAILABILITY_MAX_DAYS=90
CHANNEL_UNAVAILABILITY_HORIZON_DAYS=365
CHANNEL_UNAVAILABILITY_MAX_COUNT=50

# Медиатека и пост (07 §4 «Файлы», A-23, A-38): предел файла (не больше 50 МБ — предел MAX),
# наименьшая сторона, длинная сторона превью, загрузок в час на пользователя, одновременных
# загрузок на api и построений на worker, изображений в посте (не больше 10), срок подписанных
# ссылок кабинета, через сколько удалённый файл очищается из хранилища, пределы текста поста.
MEDIA_MAX_BYTES=52428800
MEDIA_MIN_SIDE=160
MEDIA_PREVIEW_SIDE=640
MEDIA_UPLOADS_PER_HOUR=60
MEDIA_UPLOAD_CONCURRENCY=4
MEDIA_BUILD_CONCURRENCY=2
MEDIA_ALBUM_LIMIT=10
MEDIA_URL_TTL=1h
MEDIA_RETENTION_DELETED=720h
POST_BODY_LIMIT=3800
POST_FINAL_TEXT_LIMIT=4000

# Заказ и размещения (03 §5, A-10): срок принятия (T-01) и планирования (T-13), запас до конца
# окна дат (P-02, T-01, T-14, оплата), минимальный запас и кратность времени публикации,
# окно, при котором правка поста отменяет размещение, предел корзины.
PLACEMENT_ACCEPT_TIMEOUT=24h
PLACEMENT_SCHEDULE_TIMEOUT=24h
PLACEMENT_WINDOW_GUARD=1h
PLACEMENT_MIN_LEAD=1h
PLACEMENT_SLOT_STEP=5m
PLACEMENT_REEDIT_GUARD=24h
CART_MAX_ITEMS=50

# Автопостинг и контроль (03 §5, 05 §2.8): окно повторов публикации (T-03) и пауза между
# попытками, окно поиска своего поста после неизвестного исхода, предел изображений (A-23),
# окно повторов снятия (T-10), окно претензий (T-05), срок решения спора (T-06), предложение
# доли при нарушении топа (03 §7), период сверки (T-09, A-27), запас для scheduled без
# публикации, частота чтения просмотров.
PUBLISH_RETRY_WINDOW=30m
PUBLISH_RETRY_INTERVAL=30s
PUBLISH_FIND_LOOKBACK=40m
PUBLISH_MAX_IMAGES=10
REMOVE_RETRY_WINDOW=24h
PLACEMENT_CLAIM_WINDOW=24h
DISPUTE_DEADLINE=72h
DISPUTE_TOP_VIOLATION_SHARE=5000
RECONCILE_INTERVAL=5m
RECONCILE_SCHEDULED_GRACE=5m
PUBLICATION_VIEWS_REFRESH=1h

# Оповещения администратору (07 §3): почта (через запятую) и чат дежурных в MAX.
# В production нужен хотя бы один адресат.
ALERT_EMAILS=oncall@maxim.local
ALERT_MAX_CHAT_ID=

# Планировщик (07 §2–§3): простой worker, после которого — оповещение; возраст
# необработанного входящего события для поиска зависших.
DOWNTIME_THRESHOLD=30m
STUCK_INBOUND_EVENT_AGE=10m
# Размещение в scheduled с прошедшим publish_at (07 §3).
STUCK_SCHEDULED_PLACEMENT_AGE=35m
# Публикация, которую не удалось снять по сроку (removal_overdue, 07 §3).
STUCK_REMOVAL_OVERDUE_AGE=1h

# Сроки хранения для задания cleanup (04 §8, R-10).
RETENTION_OUTBOUND_REQUEST=4320h
RETENTION_JOB_FINISHED=720h
RETENTION_JOB_FAILED=4320h
RETENTION_INBOUND_EVENT=4320h
RETENTION_AUTH_CODE=168h
RETENTION_SESSION=168h
RETENTION_ALERT=2160h
RETENTION_CHANNEL_UNAVAILABILITY=720h
