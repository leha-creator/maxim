# Сайт тестового стенда для общего edge-прокси сервера (/opt/edge).
# Деплой подставляет домен вместо __DOMAIN__, копирует файл в /opt/edge/sites/maxim.caddy
# и делает `caddy reload`.
__DOMAIN__ {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	log {
		output stdout
		format json
	}

	redir / /docs 302

	reverse_proxy maxim-mockapi:8080

	# Заглушка не запущена или ещё не развёрнута: контейнер не отвечает или его нет.
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		respond "Заглушка API ещё не развёрнута" 503
	}
}
