# Прокси тестового стенда: HTTPS для {$DOMAIN} и проксирование в заглушку API.
{
	log default {
		output stdout
		format json
		level INFO
	}
}

{$DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	log {
		output stdout
		format json
	}

	redir / /docs 302

	reverse_proxy mockapi:8080

	# Заглушка не запущена или ещё не развёрнута: контейнер не отвечает или его нет.
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		respond "Заглушка API ещё не развёрнута" 503
	}
}
