# Продакшен: переменные бэкенда (api, worker, migrate, backup). Полный список и значения по
# умолчанию — .env.example в корне; здесь только обязательное в production и отличия.
# На сервере файл лежит как /opt/maxim-production/app.env (владелец deploy, права 600) и
# заполняется из хранилища секретов человеком. Значения с меткой ПРЕДПОЛОЖЕНИЕ придуманы.
# CHANGE_ME — секрет; CHANGE_ME_BASE64_32B — `openssl rand -base64 32`.
# Проверка перед выпуском: release.sh вызывает `maxim config check --for api|worker|migrate`.

APP_ENV=production
LOG_LEVEL=info

HTTP_ADDR=:8080
METRICS_ADDR=:9090
# ПРЕДПОЛОЖЕНИЕ: адрес продакшена.
PUBLIC_BASE_URL=https://api.maxim-ads.ru
# Сеть edge-прокси; уточнить `docker network inspect edge`.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
COOKIE_SECURE=true
HTTP_SHUTDOWN_DRAIN=5s

DATABASE_URL=postgres://maxim_app:CHANGE_ME@postgres:5432/maxim?sslmode=disable
DB_APP_ROLE=maxim_app
DB_MAX_CONNS=20

# ПРЕДПОЛОЖЕНИЕ: S3 провайдера в России (Selectel, ru-1); публичная корзина за своим доменом.
S3_ENDPOINT=s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET_PRIVATE=maxim-production-private
S3_BUCKET_PUBLIC=maxim-production-public
S3_PUBLIC_BASE_URL=https://cdn.maxim-ads.ru
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_USE_SSL=true

# ПРЕДПОЛОЖЕНИЕ: SMTP российского сервиса рассылок, TLS.
SMTP_HOST=smtp.unisender.ru
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_TLS=tls
MAIL_FROM=noreply@maxim-ads.ru

APP_SECRETS_KEY=CHANGE_ME_BASE64_32B
AUTH_CODE_PEPPER=CHANGE_ME

MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=CHANGE_ME
MAX_CA_CERT_FILE=/etc/maxim/certs/russian_trusted_root_ca.pem
MAX_BOT_NAME=@maxim_ads_bot
MAX_WEBHOOK_PATH_SECRET=CHANGE_ME
MAX_WEBHOOK_SECRET=CHANGE_ME
MAX_WEBHOOK_URL=https://api.maxim-ads.ru/api/v1/webhooks/max

ORD_ENABLED=true
ORD_API_URL=https://ord.yandex.net
ORD_OAUTH_TOKEN=CHANGE_ME
# Код ККТУ всех креативов (A-42, Q-39): подтвердить с юристом.
ORD_KKTU_CODE=30.15.1
# ПРЕДПОЛОЖЕНИЕ: реквизиты ИП платформы (заглушка с корректной контрольной суммой ИНН).
ORD_PLATFORM_INN=500100732259
ORD_PLATFORM_NAME=ИП Иванов Иван Иванович
ORD_PLATFORM_LEGAL_TYPE=sole_proprietor
ORD_CONTRACT_NUMBER_PREFIX=MX-

# ПРЕДПОЛОЖЕНИЕ: реквизиты платформы в счетах и закрывающих документах — заменить настоящими.
PLATFORM_OGRNIP=304500116000157
PLATFORM_ADDRESS=CHANGE_ME
PLATFORM_BANK_ACCOUNT=CHANGE_ME
PLATFORM_BANK_NAME=CHANGE_ME
PLATFORM_BANK_BIK=CHANGE_ME
PLATFORM_BANK_CORR_ACCOUNT=CHANGE_ME
INVOICE_VAT_NOTE=Без НДС

# Комиссия платформы (A-30): должна совпадать с правилами площадки (docs/launch/legal-documents.md).
PLATFORM_FEE_RATE_BP=1500

# Оповещения дежурным: хотя бы один адресат обязателен.
ALERT_EMAILS=CHANGE_ME
ALERT_MAX_CHAT_ID=

# =============================================================================
# === Модули в разработке ===
# Переменные модулей добавляются в свой подраздел после слияния их веток; см. .env.example.
#
# --- Выплаты блогерам (Рокет Ворк): ROCKETWORK_*, PAYOUT_* ---
#
# --- Уведомления и отчёт по кампании ---
#
# --- Приёмка, споры и возвраты ---
#
# --- API администратора и отчётность ОРД ---
#
# =============================================================================
