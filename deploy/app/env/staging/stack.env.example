# Тестовое окружение: переменные стека (подстановка в deploy/app/compose.yml, контейнеры
# postgres и backup). Отдельно от app.env, чтобы пароль суперпользователя базы и ключи корзины
# копий не попадали в контейнеры api и worker. На сервере — /opt/maxim-staging/stack.env (600).
# CHANGE_ME — секрет из хранилища секретов. ПРЕДПОЛОЖЕНИЕ — придуманное значение.

COMPOSE_PROJECT_NAME=maxim-staging
# Образы: бэкенд и PostgreSQL с инструментами копий (собирает .github/workflows/release.yml).
MAXIM_IMAGE=ghcr.io/leha-creator/maxim
MAXIM_POSTGRES_IMAGE=ghcr.io/leha-creator/maxim-postgres:sha-0000000
# Файл переменных бэкенда рядом с compose.yml.
APP_ENV_FILE=./app.env
# ПРЕДПОЛОЖЕНИЕ: домен тестового окружения; подставляется в сайт edge-прокси.
DOMAIN=stage-api.maxim-ads.ru
# Префикс алиасов api в общей сети edge (уникален на сервере): maxim-staging-api-a, -api-b.
EDGE_ALIAS_PREFIX=maxim-staging
# API администратора (/api/v1/admin) — только с этих адресов (edge отвечает 403 остальным):
# CIDR через пробел. ПРЕДПОЛОЖЕНИЕ: адреса VPN или офиса команды; задать до первого выпуска.
EDGE_ADMIN_ALLOW=203.0.113.10/32

# PostgreSQL: владелец схемы (миграции), роль приложения, роль копирования.
POSTGRES_DB=maxim
POSTGRES_USER=maxim
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_APP_ROLE=maxim_app
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_BACKUP_PASSWORD=CHANGE_ME
# Миграции выполняет владелец схемы.
MIGRATE_DATABASE_URL=postgres://maxim:CHANGE_ME@postgres:5432/maxim?sslmode=disable

# Резервные копии (deploy/app/README.md, «Резервные копии»). ПРЕДПОЛОЖЕНИЕ: корзина копий у
# того же провайдера в другом регионе (ru-3, Санкт-Петербург), ключ только к этой корзине.
BACKUP_S3_ENDPOINT=s3.ru-3.storage.selcloud.ru
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
BACKUP_S3_BUCKET=maxim-backups
BACKUP_S3_USE_SSL=true
BACKUP_PREFIX=staging
BACKUP_DUMP_RETENTION_DAYS=30
BACKUP_BASE_RETENTION_DAYS=8
BACKUP_MAX_AGE_HOURS=26
BACKUP_WAL_INTERVAL=30
# Расписание (cron, UTC). ПРЕДПОЛОЖЕНИЕ: ночь по Москве.
BACKUP_BASE_CRON=30 0 * * *
BACKUP_DUMP_CRON=0 1 * * *
BACKUP_OBJECTS_CRON=0 2 * * *
BACKUP_PRUNE_CRON=0 3 * * *
BACKUP_RESTORE_CHECK_CRON=0 4 * * 0
