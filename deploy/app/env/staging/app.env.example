# Тестовое окружение: переменные бэкенда (api, worker, migrate, backup). Полный список и значения
# по умолчанию — .env.example в корне; здесь только то, что отличается или обязательно.
# На сервере файл лежит как /opt/maxim-staging/app.env (владелец deploy, права 600).
# Значения с меткой ПРЕДПОЛОЖЕНИЕ придуманы и подлежат замене. CHANGE_ME — секрет из хранилища
# секретов; CHANGE_ME_BASE64_32B — `openssl rand -base64 32`. Данные продакшена сюда не переносятся.
#
# Внешние системы: пусто — работает подделка в процессе, заполнено — тестовый контур.
#   MAX        — MAX_BOT_TOKEN тестового бота; пусто — поддельный адаптер (события шлются вручную).
#   Яндекс ОРД — ORD_OAUTH_TOKEN кабинета ord-prestable + ORD_KKTU_CODE; пусто — ordfake.
#   Банк       — подделки нет и не нужно: файл выписки «1С» делает `maxim dev statement`,
#                загружает `maxim admin money statement import` (README, «Деньги в разработке»).
#   Почта      — Mailpit из профиля mailpit (ниже); для настоящих писем — SMTP провайдера.
#   Рокет Ворк — после слияния этапа выплат (блок «Модули в разработке» в конце).

# APP_ENV=development: подделка включается отсутствием токена, команды `maxim dev` доступны.
# APP_ENV=test не подходит — в нём всегда подделки и хранилище в памяти (только для тестов Go).
APP_ENV=development
LOG_LEVEL=debug

HTTP_ADDR=:8080
METRICS_ADDR=:9090
# ПРЕДПОЛОЖЕНИЕ: адрес тестового окружения.
PUBLIC_BASE_URL=https://stage-api.maxim-ads.ru
# Сеть edge-прокси (Docker выделяет подсети из 172.16.0.0/12); уточнить `docker network inspect edge`.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
COOKIE_SECURE=true
HTTP_SHUTDOWN_DRAIN=5s

# Роль приложения; пароль совпадает с POSTGRES_APP_PASSWORD в stack.env.
DATABASE_URL=postgres://maxim_app:CHANGE_ME@postgres:5432/maxim?sslmode=disable
DB_APP_ROLE=maxim_app
DB_MAX_CONNS=10

# ПРЕДПОЛОЖЕНИЕ: S3 провайдера в России (Selectel, регион ru-1), корзины окружения.
S3_ENDPOINT=s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET_PRIVATE=maxim-staging-private
S3_BUCKET_PUBLIC=maxim-staging-public
S3_PUBLIC_BASE_URL=https://maxim-staging-public.s3.ru-1.storage.selcloud.ru
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_USE_SSL=true

# Почта: Mailpit (docker compose --profile mailpit). Веб-интерфейс — 127.0.0.1:8025 на сервере,
# смотреть через `ssh -L 8025:127.0.0.1:8025 deploy@<host>`.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=none
MAIL_FROM=noreply@stage-api.maxim-ads.ru

APP_SECRETS_KEY=CHANGE_ME_BASE64_32B
AUTH_CODE_PEPPER=CHANGE_ME

# MAX: пусто — подделка. Тестовый бот — токен, сертификат Минцифры, адрес Webhook.
MAX_BOT_TOKEN=
# Сертификат проверяется при запуске (файл должен быть в образе, deploy/certs/README.md):
# задать вместе с MAX_BOT_TOKEN, когда сертификат добавлен в репозиторий.
# MAX_CA_CERT_FILE=/etc/maxim/certs/russian_trusted_root_ca.pem
MAX_CA_CERT_FILE=
MAX_BOT_NAME=@maxim_stage_bot
MAX_WEBHOOK_PATH_SECRET=CHANGE_ME
MAX_WEBHOOK_SECRET=CHANGE_ME
MAX_WEBHOOK_URL=https://stage-api.maxim-ads.ru/api/v1/webhooks/max

# Яндекс ОРД: пусто — ordfake; токен кабинета ord-prestable — тестовый контур (ORD_API_URL
# по умолчанию https://ord-prestable.yandex.net).
ORD_ENABLED=true
ORD_OAUTH_TOKEN=
ORD_KKTU_CODE=
ORD_PLATFORM_INN=
ORD_PLATFORM_NAME=
ORD_CONTRACT_NUMBER_PREFIX=STAGE-

# Реквизиты платформы: пусто — значения разработки (вне production подставляются сами).
PLATFORM_OGRNIP=
PLATFORM_ADDRESS=

# Оповещения дежурным — в Mailpit.
ALERT_EMAILS=oncall@stage-api.maxim-ads.ru
ALERT_MAX_CHAT_ID=

# =============================================================================
# === Модули в разработке ===
# Переменные модулей добавляются в свой подраздел после слияния их веток; см. .env.example.
#
# --- Выплаты блогерам (Рокет Ворк): ROCKETWORK_*, PAYOUT_* ---
# (тестовая среда Рокет Ворк, если есть — Q-12; иначе подделка модуля выплат)
#
# --- Уведомления и отчёт по кампании ---
# Адрес кабинета для ссылок в уведомлениях (ПРЕДПОЛОЖЕНИЕ П-2: домен кабинета).
CABINET_BASE_URL=https://stage.maxim-ads.ru
#
# --- Приёмка, споры и возвраты ---
#
# --- API администратора и отчётность ОРД ---
#
# =============================================================================
