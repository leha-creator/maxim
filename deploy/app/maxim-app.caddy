# Сайт API бэкенда для общего edge-прокси сервера (/opt/edge, как у стенда заглушки).
# release.sh подставляет __DOMAIN__ (домен окружения), __PREFIX__ (EDGE_ALIAS_PREFIX) и
# __ADMIN_ALLOW__ (EDGE_ADMIN_ALLOW — адреса команды для API администратора),
# кладёт файл в /opt/edge/sites/<prefix>.caddy и делает caddy validate + reload.
#
# Выпуск без простоя (07 §8): обе ячейки в списке, запросы идут в первую живую. Активная
# проверка /readyz каждые 2 с убирает остановленную или останавливающуюся ячейку (после SIGTERM
# api отвечает 503 ещё HTTP_SHUTDOWN_DRAIN); неудачное соединение повторяется на другой ячейке.
__DOMAIN__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}

	# Изображение медиатеки — до 51 МБ (07 §4); остальные пределы проверяет api.
	request_body {
		max_size 52MB
	}

	# API администратора — только с адресов команды (07 §4, этап «API администратора»): с
	# остальных 403 до api. Роль проверяет api; это второй рубеж на случай утечки сессии.
	@admin_denied {
		path /api/v1/admin /api/v1/admin/*
		not remote_ip __ADMIN_ALLOW__
	}
	handle @admin_denied {
		header Content-Type "application/json"
		respond `{"error":{"code":"forbidden","message":"admin api is not available from this address"}}` 403
	}

	reverse_proxy __PREFIX__-api-a:8080 __PREFIX__-api-b:8080 {
		lb_policy first
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 10s

		health_uri /readyz
		health_interval 2s
		health_timeout 1s
		health_status 200
	}

	handle_errors 502 503 504 {
		header Content-Type "application/json"
		respond `{"error":{"code":"unavailable","message":"service is temporarily unavailable"}}` 503
	}
}
