# Репетиция: переменные стека (подстановка в deploy/app/compose.yml). Только значения разработки.
# Проект и сеть edge — свои, чтобы не задеть другие стеки на машине.
COMPOSE_PROJECT_NAME=maxim-rehearsal
MAXIM_IMAGE=maxim
MAXIM_POSTGRES_IMAGE=maxim-postgres:rehearsal
APP_ENV_FILE=./app.env
DOMAIN=:80
EDGE_ALIAS_PREFIX=maxim-rehearsal

POSTGRES_DB=maxim
POSTGRES_USER=maxim
POSTGRES_PASSWORD=rehearsal-owner
POSTGRES_APP_ROLE=maxim_app
POSTGRES_APP_PASSWORD=rehearsal-app
POSTGRES_BACKUP_PASSWORD=rehearsal-backup
MIGRATE_DATABASE_URL=postgres://maxim:rehearsal-owner@postgres:5432/maxim?sslmode=disable

BACKUP_S3_ENDPOINT=minio:9000
BACKUP_S3_ACCESS_KEY=minio
BACKUP_S3_SECRET_KEY=minio-secret
BACKUP_S3_BUCKET=maxim-rehearsal-backups
BACKUP_S3_USE_SSL=false
BACKUP_PREFIX=rehearsal
BACKUP_DUMP_RETENTION_DAYS=30
BACKUP_BASE_RETENTION_DAYS=8
BACKUP_MAX_AGE_HOURS=26
BACKUP_WAL_INTERVAL=5
# Расписание на репетиции не срабатывает (задания запускаются вручную).
BACKUP_BASE_CRON=0 0 1 1 *
BACKUP_DUMP_CRON=0 0 1 1 *
BACKUP_OBJECTS_CRON=0 0 1 1 *
BACKUP_PRUNE_CRON=0 0 1 1 *
BACKUP_RESTORE_CHECK_CRON=0 0 1 1 *
