# Репетиция выпуска и копий (deploy/local): переменные бэкенда. Только значения разработки;
# остальное — значения по умолчанию из .env.example. Внешние системы — подделки (нет токенов),
# S3 — MinIO, почта — Mailpit проекта репетиции.
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
METRICS_ADDR=:9090
PUBLIC_BASE_URL=http://127.0.0.1:18480
TRUSTED_PROXY_CIDRS=172.16.0.0/12
COOKIE_SECURE=false
HTTP_SHUTDOWN_DRAIN=5s

DATABASE_URL=postgres://maxim_app:rehearsal-app@postgres:5432/maxim?sslmode=disable
DB_APP_ROLE=maxim_app

S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=maxim-rehearsal-private
S3_BUCKET_PUBLIC=maxim-rehearsal-public
S3_PUBLIC_BASE_URL=http://minio:9000/maxim-rehearsal-public
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_USE_SSL=false

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=noreply@maxim.local
ALERT_EMAILS=oncall@maxim.local

APP_SECRETS_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE=
AUTH_CODE_PEPPER=dev-only-pepper-at-least-32-characters
MAX_BOT_NAME=@maxim_rehearsal_bot
MAX_WEBHOOK_PATH_SECRET=dev-only-webhook-path-secret-0123456789
MAX_WEBHOOK_SECRET=dev-only-webhook-header-secret-012345678
ORD_ENABLED=true
ORD_OAUTH_TOKEN=
